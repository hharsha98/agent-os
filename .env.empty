# Copy this file to .env, then add only the values you intend to use.
PORT=8090
AGENT_OS_HOME=~/.hermes-agent-os
HERMES_AGENT_OS_ENABLE_EXEC=0
HERMES_AGENT_OS_ENABLE_INSTALL=0
HERMES_AGENT_OS_PUBLIC_MODE=0
HERMES_AGENT_OS_REQUIRE_AUTH=0
HERMES_AGENT_OS_ADMIN_TOKEN=
OPENAI_API_KEY=
AGENT_OS_CODEX_MODEL=gpt-5.3-codex
AGENT_OS_CODEX_REASONING_EFFORT=medium
AGENT_OS_OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
MINIMAX_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OLLAMA_HOST=http://127.0.0.1:11434
