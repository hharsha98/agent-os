# Optional local screenshot gallery. Not a public Internet service.
# DEMO_PUBLIC=1 simulates agents and locks host execution.
# No API keys.

NODE_ENV=production
PORT=8090
HOST=127.0.0.1
DEMO_PUBLIC=1
HERMES_AGENT_OS_HOME=/var/lib/agent-os
HERMES_AGENT_OS_ENABLE_EXEC=0
HERMES_AGENT_OS_ENABLE_INSTALL=0
HERMES_AGENT_OS_PUBLIC_MODE=0
HERMES_AGENT_OS_REQUIRE_AUTH=0
HERMES_VOICE_ALLOW_SHELL=0
HERMES_AGENT_OS_SCHEDULER=1
