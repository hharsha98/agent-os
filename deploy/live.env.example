# /etc/agent-os/live.env
# Single-operator Contabo runtime. Not the public gallery.
# Copy to the server and fill secrets there. Never commit real keys.
# chmod 600 /etc/agent-os/live.env

NODE_ENV=production
PORT=8090
HOST=127.0.0.1

# Gallery simulation stays off. DEMO_PUBLIC=1 would lock execution and
# replace Hermes / OpenClaw / OmniRoute with canned Demo replies.
DEMO_PUBLIC=0
HERMES_AGENT_OS_DEMO_PUBLIC=0

# Text lane: OmniRoute chat completions and the OpenClaw gateway HTTP API.
AGENT_OS_LIVE_CHAT=1

# Native CLIs (hermes chat, openclaw agent, claude -p, codex exec, Cursor agent).
# Leave 0 if you only want OmniRoute + the gateway and no host process spawn.
HERMES_AGENT_OS_ENABLE_EXEC=1
HERMES_AGENT_OS_ENABLE_INSTALL=0
HERMES_VOICE_ALLOW_SHELL=0

# Lock the public URL. Set a long random token on the server.
HERMES_AGENT_OS_REQUIRE_AUTH=1
HERMES_AGENT_OS_PUBLIC_MODE=0
HERMES_AGENT_OS_ADMIN_TOKEN=
HERMES_AGENT_OS_COOKIE_SECURE=1

HERMES_AGENT_OS_HOME=/var/lib/agent-os
# Profile directory for the Unix user that owns Hermes. The systemd User=
# must be able to read this path.
HERMES_HOME=/home/REPLACE_WITH_OPERATOR/.hermes
HERMES_CLI_PATH=
HERMES_CHAT_TIMEOUT_MS=120000
# Optional: HERMES_CHAT_TOOLSETS=web,skills

# OmniRoute OpenAI-compatible API. Create the key in the OmniRoute dashboard.
OMNIROUTE_BASE_URL=https://omniroute.169.58.185.43.sslip.io/v1
OMNIROUTE_API_KEY=
OMNIROUTE_MODEL=auto

# OpenClaw gateway on the same machine. Chat completions must be enabled
# in the gateway config (gateway.http.endpoints.chatCompletions.enabled).
OPENCLAW_GATEWAY_URL=http://127.0.0.1:18789/v1
OPENCLAW_GATEWAY_TOKEN=
OPENCLAW_GATEWAY_MODEL=openclaw/default
OPENCLAW_CLI_PATH=

HERMES_AGENT_OS_SCHEDULER=1
