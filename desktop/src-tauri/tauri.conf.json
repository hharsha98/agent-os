{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agent OS",
  "version": "0.3.1",
  "identifier": "dev.agentos.desktop",
  "build": {
    "frontendDist": "../loading"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Agent OS",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/server": "resources/server",
      "resources/node": "resources/node"
    },
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
